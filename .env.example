# Copy this file to .env and fill in values
# NEVER commit .env with real keys to git

# RPC (use Anvil for local, or your provider for prod forks)
RPC_URL=http://127.0.0.1:8545

# Multi-chain support (Task 1.8)
# Set CHAIN_ID to switch: 1 (Ethereum), 42161 (Arbitrum), 8453 (Base)
CHAIN_ID=1
RPC_URL=http://127.0.0.1:8545

# Subgraph (hosted The Graph, Task 3.6 + 3.10)
# Get a free API key at https://thegraph.com/studio/ (create a subgraph or use hosted)
# The client will automatically use the modern gateway when GRAPH_API_KEY is set.
GRAPH_API_KEY=

# You can leave these as-is. The SubgraphClient will rewrite to gateway when a real key is provided.
SUBGRAPH_URL_ETHEREUM=https://api.thegraph.com/subgraphs/name/aave/protocol-v3
SUBGRAPH_URL_ARBITRUM=https://api.thegraph.com/subgraphs/name/aave/protocol-v3-arbitrum
SUBGRAPH_URL_BASE=https://api.thegraph.com/subgraphs/name/aave/protocol-v3-base

# If you want to force a specific deployment (advanced), set one of the SUBGRAPH_URL_* to a full gateway URL.

# RPCs for Forge tests
MAINNET_RPC_URL=${RPC_URL}
# Note: Use the *same* API key, but the host changes per network.
# Example with a real key would look like:
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Real Quoter (ExecutionRouter) + MOCK note:
# Default (MOCK_QUOTER unset/false): uses REAL QuoterV2 on the RPC returned by getChainConfig (derives L2 from RPC_URL key pattern).
# For production/live verify on ETH/ARB/BASE set your Alchemy key in RPC_URL; enable the networks in Alchemy dashboard if 403.
# Use MOCK_QUOTER=true to force mock path (no real RPC/Quoter needed for tests).

# Per-chain overrides (optional)
# MIN_DEBT_BASE=10000000000   # lower on L2
# MIN_NET_PROFIT_BASE=100000000

# Optional: Override addresses
# AAVE_POOL_ADDRESSES_PROVIDER=0x...
# etc.

# DB for persistence (Task 3.7)
DB_PATH=./bot-data.db
PRICE_HISTORY_RETENTION_DAYS=30
USE_SUBGRAPH_DISCOVERY=true

# Chain configuration (for TS bot)
CHAIN_ID=31337
IS_L2=false

# Private key for deployment / execution (Anvil #0 default for LOCAL TESTING ONLY)
# For production use a secure wallet / hardware / env var injection
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Execution config (prod-001.02): Centralize via config.ts (DRY_RUN, LIQUIDATOR, PRIVATE_KEY accessor)
# DRY_RUN_EXECUTION=true (DEFAULT for safety): blocks real tx signing/execution paths. 
#   Set DRY_RUN_EXECUTION=false ONLY for live prod (with funded wallet + monitoring).
#   getExecutorWallet() returns null if PRIVATE_KEY absent -> enables dry-run.
# LIQUIDATOR_ADDRESS (optional): override for pre-deployed FlashLiquidator contract addr.
#   Supports per-chain via LIQUIDATOR_ADDRESS_ETHEREUM / _ARBITRUM / _BASE (or common LIQUIDATOR_ADDRESS).
#   If unset, execution wiring (future) will deploy via artifact or use default.
#   Example: LIQUIDATOR_ADDRESS_BASE=0x... for Base-specific pre-deploy.
# PRIVATE_KEY (reused for executor via config.getExecutorPrivateKey / getExecutorWallet)
#   NEVER commit real keys. secrets-check + gitignore protect.
# All consumers MUST use: config.getChainConfig(CHAIN_ID).DRY_RUN_EXECUTION , config.getExecutorWallet(...)
DRY_RUN_EXECUTION=true
# LIQUIDATOR_ADDRESS=
# LIQUIDATOR_ADDRESS_BASE=
# (PRIVATE_KEY above reused)

# Uniswap (override for different chains)
# UNISWAP_QUOTER_V2=...

# Thresholds (can be overridden per chain in code)
# MIN_DEBT_BASE=5000000000
# MIN_NET_PROFIT_BASE=500000000

# MEV
# BRIBE_PERCENT=50
# prod-002: MOCK_MEV=true (default; sim only). Set false for real Flashbots/L2 bundle send.
# MOCK_MEV=false
# MEV_RELAY_ETHEREUM=https://relay.flashbots.net
# (L2 relays often not needed; use direct high-priority in bundle logic)
# FLASHBOTS_AUTH_KEY: Private key used ONLY for signing MEV bundles (reputation).
# Does NOT need to hold funds. If unset, the bot may generate a random one per session, but reputation is lost.
# FLASHBOTS_AUTH_KEY=